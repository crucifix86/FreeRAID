# Build artifacts — not committed, generated by build-image.sh
build/

# VM disk images
*.qcow2
*.img
*.iso

# Imported / test compose files (per-host, not source)
compose/

# Captured Unraid backups (private, large) — keep out of the repo
test-backups/

# Temp files
*.tmp
*.bak

# Installer build output
dist/
*.spec
__pycache__/
